# Keep .streamlit/config.toml if it contains only non-secret settings.

# JavaScript / frontend dependencies and generated output
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/
.parcel-cache/
.vite/
.next/
.nuxt/
coverage/

# Local frontend environment overrides
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editors and operating systems
.vscode/
.idea/
*.code-workspace
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Cloud / deployment local state
.terraform/
*.tfstate
*.tfstate.*
crash.log
.serverless/
.aws-sam/

# Local-only overrides
*.local

# IMPORTANT:
# Do not ignore *.sql globally: reviewed SQL source scripts belong in Git.
# Do not ignore *.ps1 globally: safe project automation may belong in Git.
# Review all files for credentials before committing.
