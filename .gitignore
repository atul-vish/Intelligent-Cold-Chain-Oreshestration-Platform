# Secrets and credentials
.env
.env.*
!.env.example
!.env.template
.streamlit/secrets.toml
.streamlit/secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/
*_credentials.*
*credentials*.json

# Python bytecode, environments, caches, and test output
__pycache__/
*.py[cod]
*$py.class
*.pyd
.venv/
venv/
env/
ENV/
.python-env/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
