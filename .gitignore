build/
dist/
site/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Jupyter
.ipynb_checkpoints/

# Logs and temporary files
*.log
logs/
log/
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.pid
*.seed

# Local databases
*.sqlite
*.sqlite3
*.db
*.duckdb

# Raw/processed datasets (keep approved sample data intentionally)
Data/raw/
Data/processed/
data/raw/
data/processed/
*.parquet
*.feather
*.arrow
*.h5
*.hdf5

